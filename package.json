{
  "name": "planner-equipe",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de tarefas colaborativo em tempo real para equipes",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
